    "help_txt_care": "CARE",
    "help_txt_feed": "f feed - meat fills; the pill",
    "help_txt_feed_2": "  cures sickness, free and infinite",
    "help_txt_heal": "h heal - bandage a battle injury,",
    "help_txt_heal_2": "  free (a wound also mends with time)",
    "help_txt_clean": "c clean poop",
    "help_txt_lights": "o lights   v assistant - paid help:",
    "help_txt_lights_2": "  a fee per visit + an hourly wage",
    "help_txt_gift": "ENTER accepts a found gift",
    "help_txt_mistakes": "Ignored calls add ✗ care mistakes",
    "help_txt_mistakes_2": "(status card): they pick which form",
    "help_txt_mistakes_3": "comes next and reset each stage.",
    "help_txt_fatal": "20 is fatal - and 2 days into an",
    "help_txt_fatal_2": "Ultimate/Mega stage just 5 can be.",
    "help_txt_energy": "Energy fuels drills, fights and the",
    "help_txt_energy_2": "road; sleep refills it each night.",
    "help_txt_ailments": "Two ailments: SICKNESS (filth or",
    "help_txt_ailments_2": "fat) takes the pill, free on F.",
    "help_txt_ailments_3": "Battle INJURY takes H - free; a",
    "help_txt_ailments_4": "wound also closes with time. Both",
    "help_txt_ailments_5": "block fights and whisper to death.",
    "help_txt_discipline": "p discipline - praise & scold:",
    "help_txt_discipline_2": "  scold a tantrum (+manners), praise",
    "help_txt_discipline_3": "  a proud win; ignored tantrums",
    "help_txt_discipline_4": "  cost a care mistake",
    "help_txt_alarms": "Alarms count the urgency: one beep",
    "help_txt_alarms_2": "routine, two a mess, three urgent.",
    "help_txt_explore": "EXPLORE",
    "help_txt_battle": "m battle - fight a matched rival:",
    "help_txt_battle_2": "  a real bout (wins, exp, training)",
    "help_txt_battle_3": "  but no purse; costs 5 energy (10",
    "help_txt_battle_4": "  in the tank to start)",
    "help_txt_rival": "  every 3rd bout your named RIVAL",
    "help_txt_rival_3": "  on the datacore PERSON page",
    "help_txt_adv": "a adventure - head out on the road",
    "help_txt_adv_2": "  cross a zone, fell its boss, then",
    "help_txt_adv_3": "  rest in towns, find loot; towns",
    "help_txt_adv_4": "  sell eggs, map clears unlock them",
    "help_txt_drop": "  beaten foes can DROP their goods -",
    "help_txt_drop_2": "  bosses guard the rarest relics",
    "help_txt_raid": "r raid - the community boss: fight",
    "help_txt_raid_2": "  10-round volleys, break the shared",
    "help_txt_raid_3": "  pool together, claim the purse",
    "help_txt_cup": "u cup - hourly tournaments; win",
    "help_txt_cup_2": "  trophies to unlock new eggs; a",
    "help_txt_lobby": "l lobby - go online: chat, and",
    "help_txt_lobby_2": "  battle / jogress other players",
    "help_txt_grow": "GROW",
    "help_txt_grow_1": "Eggs hatch, then evolve by HOW you",
    "help_txt_grow_2": "raise them - care, train, battles.",
    "help_txt_grow_3": "Each egg has its own line to a Mega.",
    "help_txt_train": "t train - time the strike: PERFECT",
    "help_txt_train_2": "  locks the power form your lobby",
    "help_txt_train_3": "  rivals will face",
    "help_txt_dna": "x DNA - steer the next evolution:",
    "help_txt_dna_2": "  wager bits, mash to bank a Field,",
    "help_txt_dna_3": "  charge ONE Field to its threshold;",
    "help_txt_dna_4": "  the next evolution takes that road",
    "help_txt_datacore_2": "  ENTER on its trophy page opens the",
    "help_txt_datacore_3": "  ALBUM - every species, in dex order",
    "help_txt_legacy": "  on its LEGACY page, the HALL OF",
    "help_txt_legacy_2": "  MEMORY - every elder, remembered",
    "help_txt_egg_guide": "e egg guide - every egg + what",
    "help_txt_egg_guide_2": "  earns it, with live progress",
    "help_txt_manage": "MANAGE",
    "help_txt_shop": "s shop   b bag   n scenes",
    "help_txt_shop_3": "  titles that ride your status card",
    "help_txt_capsule": "  a CAPSULE opens into a surprise,",
    "help_txt_capsule_2": "  finer on festival days",
    "help_txt_opts": "g options   i report a bug   q quit",
    "help_txt_opts_2": "  themes, sound, cloud sync, your",
    "help_txt_opts_3": "  account, updates, every key",
    "help_txt_guide_2": "SPACE doubles ENTER on most screens;",
    "help_txt_guide_3": "PgUp/PgDn leap through long lists.",
    "help_txt_grave": "LEGACY",
    "help_txt_grave_1": "Neglect, hunger, sickness or age",
    "help_txt_grave_2": "take it in the end. The grave asks",
    "help_txt_grave_3": "what carries to the next one:",
    "help_txt_grave_4": "E grave os dados para o herdeiro",
    "help_txt_grave_5": "B guarde o bônus de cuidados",
    "help_txt_grave_6": "Only one etch may stand: if data is",
    "help_txt_grave_7": "already banked, E takes the new one,",
    "help_txt_grave_9": "n starts the next egg.",
    "help_txt_tips": "TIPS",
    "help_txt_tips_1": "Feed when hungry, clean the poop,",
    "help_txt_tips_2": "and let it sleep at night. Win cups,",
    "help_txt_tips_3": "fell raids, link with tamers, play a",
    "help_txt_tips_4": "festival - every egg is earned.",
